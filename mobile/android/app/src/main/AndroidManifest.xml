<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ldleread.app"
    android:versionCode="47"
    android:versionName="1.7.3.2">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Android 11+ 包可见性：不声明这个，TextToSpeech 找不到任何引擎 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.android.vending" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 应用内下载完自动拉起安装器；不装这个权限，1.6.4 的自动安装只能退化成打开设置页 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 文件管理器「打开方式」:只认 TXT 和 EPUB,不抢别的文件类型 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
            </intent-filter>
            <!-- 其它应用「分享」文件过来 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WebPageActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- 把下载好的 APK 以 content:// 交给系统安装器（Android 7+ 不许用 file://） -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.ldleread.app.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
